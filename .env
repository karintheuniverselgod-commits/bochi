# Telegram
TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token

# Telegram owner IDs
# Use /myid in Telegram to find your ID.
# Multiple owners can be separated by commas.
OWNER_IDS=123456789

# Optional MongoDB configuration.
# Leave MONGODB_URI empty if you do not want
# database persistence yet.
MONGODB_URI=
MONGODB_DATABASE=manga_search_bot

# MongoDB connection pool
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=10

# MongoDB connection timeout settings
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# Source API and website behavior
SOURCE_TIMEOUT_SECONDS=15
SEARCH_RESULT_LIMIT=8
CHAPTERS_PER_PAGE=20

# Logging
LOG_LEVEL=INFO
